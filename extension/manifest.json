{
  "manifest_version": 3,
  "name": "Snipy — Anti-Overengineering Assistant",
  "version": "1.0.0",
  "description": "Real-time simplicity filter, anti-overengineering coach, and algorithmic code optimizer powered by AWS Bedrock.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Snipy — Anti-Overengineering Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "activate_sniply": {
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "Command+Period"
      },
      "description": "Activate Snipy Code Coach"
    },
    "optimize_selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Optimize Active Code with Snipy"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/icons/*",
        "assets/Screen-constraints/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
