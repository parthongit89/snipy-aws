        <mxCell id="n_auth_gate" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FAF5FF;strokeColor=#A855F7;strokeWidth=2;fontColor=#581C87;align=center;arcSize=8;" value="&lt;b&gt;Mandatory Google Auth Gate &amp;amp; Neon DB Registration&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #6B21A8;'&gt;• &lt;b&gt;Mandatory Google OAuth&lt;/b&gt; before download&lt;br/&gt;• Upserts user profile in Neon DB (sniply_users)&lt;br/&gt;• Enables 100% developer tracking &amp;amp; telemetry&lt;/span&gt;">
          <mxGeometry x="440" y="160" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n_download" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;align=center;arcSize=8;" value="&lt;b&gt;Extension ZIP Download (sniply-extension.zip)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #1D4ED8;'&gt;• Unlocked exclusively post-registration&lt;br/&gt;• Auto-triggers download of .zip package&lt;br/&gt;• Manifest V3 pre-packaged for Chrome &amp;amp; Edge&lt;/span&gt;">
          <mxGeometry x="870" y="160" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n_browsers" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;align=center;arcSize=8;" value="&lt;b&gt;Target Browser Runtime Setup&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #334155;'&gt;• &lt;b&gt;Google Chrome&lt;/b&gt;: chrome://extensions/ (Dev Mode)&lt;br/&gt;• &lt;b&gt;Microsoft Edge&lt;/b&gt;: edge://extensions/ (Dev Mode)&lt;br/&gt;• Load Unpacked Folder / ZIP Installation&lt;/span&gt;">
          <mxGeometry x="1300" y="160" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n_shortcuts" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;align=center;arcSize=8;" value="&lt;b&gt;Extension Keyboard Controller&lt;/b&gt;&lt;br/&gt;&lt;div style='font-size: 12px; margin-top: 4px;'&gt;&lt;b style='color: #15803D;'&gt;[ Ctrl + . ]&lt;/b&gt; : Start / Activate Extension&lt;br/&gt;&lt;b style='color: #B91C1C;'&gt;[ Ctrl + Backspace ]&lt;/b&gt; : Stop / Deactivate&lt;/div&gt;&lt;span style='font-size: 10px; color: #166534;'&gt;Global keydown interceptor &amp;amp; status indicator&lt;/span&gt;">
          <mxGeometry x="70" y="340" width="310" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n_editors" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#0F172A;align=center;arcSize=8;" value="&lt;b&gt;Active Coding Environments (DOM Targets)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #334155;'&gt;• &lt;b&gt;Monaco Editor&lt;/b&gt; (Google Colab, LeetCode, CodeChef)&lt;br/&gt;• &lt;b&gt;CodeMirror 5/6&lt;/b&gt; (JupyterLab, Classic Notebook, Replit)&lt;br/&gt;• &lt;b&gt;Ace Editor&lt;/b&gt; (Programiz, OnlineGDB, HackerRank)&lt;br/&gt;• Standard &lt;b&gt;&amp;lt;textarea&amp;gt;&lt;/b&gt; &amp;amp; editable elements&lt;/span&gt;">
          <mxGeometry x="440" y="340" width="370" height="110" as="geometry"/>
