          <mxGeometry x="1340" y="545" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="n_gateway" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;align=center;arcSize=8;" value="&lt;b&gt;FastAPI Optimization Gateway&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #475569;'&gt;• &lt;b&gt;Endpoints:&lt;/b&gt; /api/v1/optimize, /api/v1/sync, /api/v1/analytics&lt;br/&gt;• High concurrency ASGI runner with rate limiting&lt;br/&gt;• Token-efficient JSON stream formatter&lt;/span&gt;">
          <mxGeometry x="70" y="755" width="340" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n_ast" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#4C1D95;align=center;arcSize=8;" value="&lt;b&gt;Static AST &amp;amp; Intent Analyzer&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #5B21B6;'&gt;• Pre-parses code into AST (Tree-Sitter / Python ast)&lt;br/&gt;• Detects nested loop depths (O(N²) risk), unused vars&lt;br/&gt;• Syntax error &amp;amp; indentation mistake pre-check&lt;br/&gt;• &lt;b&gt;Ponytail Guardrails:&lt;/b&gt; YAGNI &amp;amp; standard library ladder&lt;/span&gt;">
          <mxGeometry x="460" y="755" width="360" height="115" as="geometry"/>
        </mxCell>
