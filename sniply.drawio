          <mxGeometry x="870" y="755" width="310" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n_bedrock" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#4C1D95;strokeColor=#2E1065;strokeWidth=2;fontColor=#FFFFFF;align=center;arcSize=8;" value="&lt;b&gt;AWS Bedrock AI Inference Engine&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size: 11px; color: #E9D5FF;'&gt;• &lt;b&gt;Model:&lt;/b&gt; Claude 3.5 Haiku (anthropic.claude-3-5-haiku-20241022)&lt;br/&gt;• Temperature: 0.1 (Strict deterministic simplification)&lt;br/&gt;• Ultra-fast low latency (&amp;lt; 700ms), 100-120 line focus&lt;br/&gt;• Outputs Big-O, line-by-line diffs &amp;amp; tooltip JSON payload&lt;/span&gt;">
          <mxGeometry x="1230" y="755" width="400" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n_neondb" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;shadow=1;fillColor=#0284C7;strokeColor=#0369A1;strokeWidth=2;fontColor=#FFFFFF;align=center;arcSize=8;" value="&lt;b&gt;Neon PostgreSQL Cloud Database&lt;/b&gt;&lt;br/&gt;&lt;div style='font-size: 11px; color: #E0F2FE; text-align: left; padding: 4px 10px;'&gt;• &lt;b&gt;sniply_users:&lt;/b&gt; firebase_uid, email, display_name, last_active&lt;br/&gt;• &lt;b&gt;optimizations:&lt;/b&gt; code, complexity before/after, mistakes JSONB&lt;br/&gt;• &lt;b&gt;daily_metrics:&lt;/b&gt; metric_date, total_fixes, tokens_used, syntax_errors&lt;br/&gt;• &lt;b&gt;Security:&lt;/b&gt; Connection pooling, sslmode=require, least-privilege&lt;/div&gt;">
          <mxGeometry x="70" y="970" width="390" height="175" as="geometry"/>
